# PostgreSQL connection (used by the ETL, case builder, entity network, and dashboard)
PGHOST=localhost
PGPORT=5432
PGDATABASE=phantom_equity
PGUSER=postgres
PGPASSWORD=

# Optional alternative to the individual PG settings:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/phantom_equity

# Optional NYC Open Data Socrata app token (improves request limits)
SOCRATA_APP_TOKEN=

# Optional name shown in the local analyst dashboard
ANALYST_NAME=
